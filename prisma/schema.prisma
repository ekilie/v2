// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Developer {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Personal Information
  fullName          String
  email             String   @unique
  phone             String?
  location          String?
  timezone          String?
  
  // Professional Information
  title             String
  bio               String?
  yearsOfExperience Int
  experienceLevel   ExperienceLevel
  
  // Skills and Technologies
  skills            String[] // Array of technology names
  primarySkills     String[] // Main expertise areas
  
  // Portfolio and Links
  githubUrl         String?
  linkedinUrl       String?
  portfolioUrl      String?
  resumeUrl         String?
  
  // Availability
  availability      Availability
  hourlyRate        Float?
  preferredWorkType WorkType
  
  // Status
  isActive          Boolean  @default(true)
  isAvailable       Boolean  @default(true)
  profileComplete   Boolean  @default(false)
  
  // Relations
  applications      Application[]
  
  @@index([email])
  @@index([isActive, isAvailable])
  @@index([experienceLevel])
}

model ClientInquiry {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Client Information
  fullName        String
  email           String
  company         String?
  phone           String?
  
  // Inquiry Details
  inquiryType     InquiryType
  message         String
  budget          String?
  timeline        String?
  
  // Developer Requirements
  requiredSkills  String[] // Technologies they need
  experienceLevel ExperienceLevel?
  projectType     String?
  
  // Status
  status          InquiryStatus @default(NEW)
  priority        Priority      @default(MEDIUM)
  assignedTo      String?
  notes           String?
  
  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model Application {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  developerId String
  developer   Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)
  
  // Application Details
  coverLetter String?
  status      ApplicationStatus @default(PENDING)
  
  // Interview Process
  interviewDate    DateTime?
  interviewNotes   String?
  
  // Decision
  decidedAt        DateTime?
  rejectionReason  String?
  
  @@index([developerId])
  @@index([status])
  @@index([createdAt])
}

model Testimonial {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  name        String
  role        String
  company     String?
  avatar      String?
  content     String
  rating      Int      @default(5)
  type        TestimonialType
  isPublished Boolean  @default(false)
  
  @@index([isPublished, type])
}

// Enums
enum ExperienceLevel {
  JUNIOR      // 0-2 years
  MID         // 2-5 years
  SENIOR      // 5-10 years
  LEAD        // 10+ years
  PRINCIPAL   // Expert/Architect
}

enum Availability {
  AVAILABLE_NOW
  AVAILABLE_2_WEEKS
  AVAILABLE_1_MONTH
  NOT_AVAILABLE
}

enum WorkType {
  FULL_TIME
  PART_TIME
  CONTRACT
  FREELANCE
}

enum InquiryType {
  HIRE_DEVELOPER
  PROJECT_CONSULTATION
  PARTNERSHIP
  GENERAL
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  CONTACTED
  QUALIFIED
  CONVERTED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ApplicationStatus {
  PENDING
  UNDER_REVIEW
  INTERVIEW_SCHEDULED
  INTERVIEWED
  ACCEPTED
  REJECTED
}

enum TestimonialType {
  CLIENT
  DEVELOPER
}
